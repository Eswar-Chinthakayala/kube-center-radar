# Copy this to .env and fill in your values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://kubecenter:kubecenter_dev@localhost:25432/kubecenter

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:26379

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
AMQP_URL=amqp://kubecenter:kubecenter_dev@localhost:25672/

# ── Keycloak OIDC ─────────────────────────────────────────────────────────────
OIDC_ISSUER=http://localhost:28080/realms/kube-center
OIDC_CLIENT_ID=kube-center-app
OIDC_CLIENT_SECRET=kube-center-secret
OIDC_REDIRECT_URL=http://localhost:9280/auth/callback

# ── SMTP (for Keycloak OTP emails) ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Kube Center
SMTP_SSL=false
SMTP_STARTTLS=true
